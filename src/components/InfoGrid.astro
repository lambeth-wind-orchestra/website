---
interface Props {
  items: {
    title: string;
    description: string;
  }[];
}

const { items } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
  {
    items.map((item) => (
      <div class="bg-white p-8 rounded-3xl border border-lwo-navy/5 shadow-sm hover:shadow-md transition-shadow">
        <h3 class="text-2xl font-sans font-bold text-lwo-navy mb-4">
          {item.title}
        </h3>
        <p class="text-lwo-navy/70 leading-relaxed m-0 text-lg">
          {item.description}
        </p>
      </div>
    ))
  }
</div>
