---
const { event } = Astro.props;
const { name, date, startTime, endTime, type, description } = event.data;

const formattedDate = date
  ? new Date(date).toLocaleDateString('en-GB', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : 'Date TBC';

const timeDisplay = startTime
  ? endTime
    ? `${startTime} – ${endTime}`
    : startTime
  : 'Time TBC';

const typeColors = {
  concert: 'text-lwo-navy border-lwo-sage/30 bg-lwo-sage/10',
  bandstand: 'text-lwo-navy border-lwo-sage/20 bg-lwo-off-white',
  other: 'text-lwo-navy border-lwo-navy/10 bg-lwo-off-white',
};
---

<div
  class="flex flex-col h-full bg-white border border-lwo-navy/5 transition-all duration-300 hover:border-lwo-sage/50 hover:shadow-lg hover:shadow-lwo-sage/5 group rounded-sm p-8"
>
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <span
        class:list={[
          'inline-flex items-center px-3 py-1 text-[11px] font-bold rounded-full border',
          typeColors[type] || typeColors.other,
        ]}
      >
        {type.charAt(0).toUpperCase() + type.slice(1)}
      </span>
    </div>

    <div class="space-y-1">
      <p class="text-sm font-semibold text-lwo-sage m-0">
        {formattedDate}
      </p>
      <p class="text-sm text-lwo-navy/60 m-0">
        {timeDisplay}
      </p>
    </div>

    <h3
      class="text-2xl md:text-3xl font-sans font-bold text-lwo-navy group-hover:text-lwo-sage transition-colors duration-300 leading-tight m-0"
    >
      <a href={`/events/${event.id}`} class="focus:outline-none">
        {name}
      </a>
    </h3>

    {
      description && description !== 'TODO' && (
        <p class="text-lwo-navy/80 line-clamp-2 leading-relaxed text-base m-0">
          {description}
        </p>
      )
    }
  </div>

  <div class="mt-auto pt-8">
    <a
      href={`/events/${event.id}`}
      class="inline-flex items-center gap-2 text-sm font-bold text-lwo-navy hover:text-lwo-sage transition-colors"
      aria-label={`View details for ${name}`}
    >
      View Event
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 transition-transform group-hover:translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"
          d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </a>
  </div>
</div>
