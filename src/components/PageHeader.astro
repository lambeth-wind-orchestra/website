---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<section
  class={`relative w-full py-16 md:py-24 overflow-hidden ${image ? 'bg-lwo-navy text-white' : 'bg-lwo-sage text-white'}`}
>
  {
    image && (
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-lwo-navy/70 z-10" />
        <div
          class="w-full h-full bg-cover bg-center"
          style={`background-image: url('${image}')`}
        />
      </div>
    )
  }

  <div class="relative z-10 prose-container">
    <slot name="before" />
    <div class="animate-fade-in-up">
      <h1
        class="font-sans font-bold text-white m-0 text-4xl md:text-6xl leading-tight tracking-tight"
      >
        {title}
      </h1>
      {
        description && (
          <p class="mt-6 text-lg md:text-xl text-white/90 max-w-2xl font-sans font-normal leading-relaxed mb-0">
            {description}
          </p>
        )
      }
    </div>
    <slot />
  </div>
</section>
