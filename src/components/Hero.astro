---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section
  class="relative w-full h-[calc(100vh-80px)] min-h-[600px] flex items-center justify-center overflow-hidden bg-lwo-navy"
>
  <!-- Background Image Placeholder -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-lwo-navy/60 z-10"></div>
    <!--
      Developer Note: Place your hero image in src/assets/images/hero.jpg
      and replace this div with an <Image /> component or a background-image style.
    -->
    <div
      class="w-full h-full bg-cover bg-center"
      style="background-image: url('https://images.unsplash.com/photo-1511192336575-5a79af67a629?q=80&w=2000&auto=format&fit=crop');"
    >
    </div>
  </div>

  <!-- Content Overlay -->
  <div class="relative z-20 container mx-auto px-6">
    <div class="max-w-4xl">
      <h1
        class="text-white text-5xl md:text-7xl lg:text-8xl font-sans font-bold leading-[1.1] tracking-tight animate-fade-in-up"
      >
        {title}
      </h1>

      <p
        class="text-white/90 text-xl md:text-2xl font-sans font-normal max-w-2xl mt-8 leading-relaxed opacity-0 animate-fade-in-up stagger-1"
      >
        {description}
      </p>

      <div
        class="flex flex-col sm:flex-row items-center gap-4 mt-12 opacity-0 animate-fade-in-up stagger-2"
      >
        <a
          href="/join"
          class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-4 bg-lwo-sage text-lwo-navy font-sans font-bold text-lg rounded-sm transition-all duration-300 hover:bg-white hover:scale-105"
        >
          Join Us
        </a>
        <a
          href="/events"
          class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-4 border-2 border-white text-white font-sans font-bold text-lg rounded-sm transition-all duration-300 hover:bg-white/10 hover:scale-105"
        >
          Upcoming Events
        </a>
      </div>
    </div>
  </div>
</section>
