---
import HeroMesh from './HeroMesh.astro';

interface Props {
  title: string;
  description: string;
  primaryCTA: string;
  secondaryCTA: string;
}

const { title, description, primaryCTA, secondaryCTA } = Astro.props;
---

<section
  class="relative w-full min-h-[calc(100vh-5rem)] flex items-center justify-center overflow-hidden bg-white py-24"
>
  <HeroMesh complexity={5} speed={0.2} opacity={0.3} grain={true} />

  <!-- Content -->
  <div class="relative z-10 container mx-auto px-6 text-center">
    <div class="max-w-4xl mx-auto space-y-10">
      <div class="overflow-hidden">
        <h1
          class="text-lwo-navy text-5xl md:text-7xl lg:text-8xl font-sans font-black leading-[1] tracking-tighter animate-fade-in-up"
        >
          {title}
        </h1>
      </div>

      <p
        class="text-lwo-navy text-xl md:text-2xl font-sans font-medium max-w-2xl mx-auto leading-relaxed opacity-0 animate-fade-in-up stagger-1"
      >
        {description}
      </p>

      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-6 pt-6 opacity-0 animate-fade-in-up stagger-2"
      >
        <a
          href="/events"
          class="group relative min-w-[220px] inline-flex items-center justify-center px-10 py-5 bg-lwo-sage text-lwo-navy font-sans font-bold text-lg transition-all duration-500 rounded-full hover:bg-lwo-sage-dark hover:scale-105 focus:scale-105 focus:outline-none focus:ring-4 focus:ring-lwo-sage/30 active:scale-95 shadow-xl shadow-lwo-sage/20"
        >
          {primaryCTA}
        </a>
        <a
          href="/about"
          class="group relative min-w-[220px] inline-flex items-center justify-center px-10 py-5 bg-lwo-navy text-white font-sans font-bold text-lg transition-all duration-500 rounded-full hover:bg-lwo-navy-dark hover:scale-105 focus:scale-105 focus:outline-none focus:ring-4 focus:ring-lwo-navy/30 active:scale-95 shadow-xl shadow-lwo-navy/20"
        >
          {secondaryCTA}
        </a>
      </div>
    </div>
  </div>
</section>
