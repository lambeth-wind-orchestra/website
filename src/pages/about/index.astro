---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'about');

if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <PageHeader
    title={entry.data.title}
    description={entry.data.description}
    image={entry.data.image}
  />

  <section class="bg-white section-padding">
    <div class="prose-container">
      <div
        class="prose max-w-none prose-p:leading-relaxed prose-headings:font-sans prose-headings:font-bold prose-headings:text-lwo-sage prose-img:rounded-3xl prose-img:shadow-2xl"
      >
        <Content />
      </div>
    </div>
  </section>
</Layout>
