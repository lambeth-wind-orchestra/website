---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, getEntry } from 'astro:content';
import EventCard from '../../components/EventCard.astro';

const entry = await getEntry('pages', 'events');
const allEvents = await getCollection('events');

const today = new Date();
today.setHours(0, 0, 0, 0);

// Filter to only upcoming events (including those without a date)
const upcomingEvents = allEvents
  .filter((event) => !event.data.date || new Date(event.data.date) >= today)
  .sort((a, b) => {
    if (!a.data.date) return 1;
    if (!b.data.date) return -1;
    return new Date(a.data.date).getTime() - new Date(b.data.date).getTime();
  });
---

<Layout
  title={entry?.data.title || 'Events'}
  description={entry?.data.description}
>
  <PageHeader
    title={entry?.data.title || 'Events'}
    description={entry?.data.description}
  />

  <section class="bg-white section-padding">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      {
        upcomingEvents.length > 0 ? (
          <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {upcomingEvents.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        ) : (
          <div class="text-center py-32 bg-lwo-off-white rounded-sm border-2 border-dashed border-lwo-navy/5">
            <p class="text-lwo-navy/40 font-bold text-sm">
              No upcoming events scheduled at this time.
            </p>
            <p class="mt-4 text-lwo-navy/60 font-medium">
              Please check back soon or follow us for updates.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>
