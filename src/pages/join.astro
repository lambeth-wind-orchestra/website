---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import VacancyList from '../components/VacancyList.astro';
import InfoGrid from '../components/InfoGrid.astro';
import Map from '../components/Map.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'join');

if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
const { vacancies, instruments, rehearsals, membership } = entry.data;

const infoItems = [
  {
    title: 'Rehearsal Times',
    description: `We rehearse every ${rehearsals?.day} from ${rehearsals?.time}.`,
  },
  {
    title: 'Membership Fees',
    description: membership?.fees || '',
  },
  {
    title: 'Membership Policy',
    description: membership?.policy || '',
  },
];
---

<Layout title={entry.data.title} description={entry.data.description}>
  <PageHeader title={entry.data.title} description={entry.data.description} />

  <!-- Intro Section -->
  <section class="bg-white section-padding">
    <div class="prose-container">
      <div
        class="prose max-w-none prose-p:leading-relaxed prose-p:text-xl prose-p:text-lwo-navy/80 prose-headings:font-sans prose-headings:font-bold prose-headings:text-lwo-sage"
      >
        <Content />
      </div>
    </div>
  </section>

  <!-- Vacancies Section -->
  {
    vacancies && instruments && (
      <section class="bg-lwo-off-white section-padding">
        <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          <h2 class="text-3xl md:text-4xl font-sans font-bold text-lwo-navy mb-12 text-center">
            Join the Band
          </h2>
          <VacancyList vacancies={vacancies} allInstruments={instruments} />
        </div>
      </section>
    )
  }

  <!-- Rehearsals & Map Section -->
  <section class="bg-white section-padding">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <h2
            class="text-3xl md:text-4xl font-sans font-bold text-lwo-navy mb-8"
          >
            Where & When
          </h2>
          <InfoGrid items={infoItems} />
        </div>
        <div>
          {
            rehearsals?.googleMapsEmbedUrl && (
              <Map
                embedUrl={rehearsals.googleMapsEmbedUrl}
                address={rehearsals.address}
                locationName={rehearsals.location}
              />
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section
    class="bg-lwo-navy section-padding text-white overflow-hidden relative"
  >
    <!-- Decorative background elements -->
    <div
      class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-96 h-96 bg-lwo-sage/20 rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-96 h-96 bg-lwo-sage/10 rounded-full blur-3xl"
    >
    </div>

    <div
      class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 text-center relative z-10"
    >
      <h2 class="text-4xl md:text-5xl font-sans font-bold mb-8">
        Ready to play with us?
      </h2>
      <p class="text-xl md:text-2xl text-white/80 max-w-2xl mx-auto mb-12">
        We'd love to hear from you! Get in touch to check current availability
        for your instrument.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-6">
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-10 py-4 bg-lwo-sage text-white font-sans font-bold text-xl rounded-sm transition-all hover:scale-105 hover:bg-lwo-sage/90 shadow-lg"
        >
          Contact Us to Join
        </a>
      </div>
    </div>
  </section>
</Layout>
