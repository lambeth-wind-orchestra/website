---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import EventCard from '../components/EventCard.astro';
import { getEntry, getCollection, render } from 'astro:content';

const entry = await getEntry('pages', 'home');
const allEvents = await getCollection('events');

if (!entry) {
  return Astro.redirect('/404');
}

const today = new Date();
today.setHours(0, 0, 0, 0);

const upcomingEvents = allEvents
  .filter((event) => !event.data.date || new Date(event.data.date) >= today)
  .sort((a, b) => {
    if (!a.data.date) return 1;
    if (!b.data.date) return -1;
    return new Date(a.data.date).getTime() - new Date(b.data.date).getTime();
  })
  .slice(0, 3);

const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <Hero
    title={entry.data.hero?.title || entry.data.title}
    description={entry.data.hero?.description || ''}
  />

  {
    upcomingEvents.length > 0 && (
      <section class="bg-lwo-off-white section-padding">
        <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-16">
            <h2 class="text-4xl md:text-5xl font-sans font-bold text-lwo-navy m-0">
              Upcoming Events
            </h2>
            <a
              href="/events"
              class="group inline-flex items-center gap-2 text-lg font-sans font-bold text-lwo-sage transition-all"
            >
              <span class="relative pb-1 after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-full after:bg-lwo-sage after:origin-right after:scale-x-0 group-hover:after:scale-x-100 group-hover:after:origin-left after:transition-transform after:duration-500">
                View all events
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 transition-transform group-hover:translate-x-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"
                />
              </svg>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {upcomingEvents.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-white section-padding">
    <div class="prose-container">
      <div
        class="prose max-w-none prose-p:leading-relaxed prose-headings:font-sans prose-headings:font-bold prose-headings:text-lwo-sage"
      >
        <Content />
      </div>
    </div>
  </section>
</Layout>
